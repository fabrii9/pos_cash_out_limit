<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_cash_out_limit.CashMovePopupAmountPreview"
       t-inherit="point_of_sale.CashMovePopup"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'input-amount')]" position="after">
            <div t-if="format(state.amount)"
                 class="alert alert-info py-2 mb-2"
                 aria-live="polite">
                Importe ingresado: <strong t-esc="format(state.amount)"/>
            </div>
        </xpath>
    </t>
</templates>
